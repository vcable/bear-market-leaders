{"text": "<style>\n.gl { display: grid; gap: var(--cds-gap-lg); font-family: var(--font-anthropic-sans); color: var(--color-fg); }\n.gl-head { display: grid; gap: var(--cds-gap-xs); }\n.gl-h1 { margin: 0; font-family: var(--font-anthropic-serif); font-weight: 400; font-size: var(--cds-font-size-title); line-height: 1.15; text-wrap: balance; }\n.gl-takeaway { margin: 0; font-size: var(--cds-font-size-body); color: var(--color-fg-muted); max-width: 72ch; }\n.gl-takeaway span { color: var(--color-fg); font-weight: var(--cds-font-weight-medium); }\n.gl-controls { display: flex; flex-wrap: wrap; gap: var(--cds-gap-sm) var(--cds-gap-md); align-items: center; }\n.gl-seg { display: inline-flex; gap: 2px; padding: 2px; border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); background: var(--color-panel); }\n.gl-btn { font: inherit; font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); background: transparent; border: 0; border-radius: var(--cds-radius); padding: var(--cds-pad-xs) var(--cds-pad-sm); cursor: pointer; }\n.gl-btn:hover { color: var(--color-fg); }\n.gl-btn[aria-pressed=\"true\"] { color: var(--color-fg); background: color-mix(in srgb, var(--color-fg) 9%, transparent); font-weight: var(--cds-font-weight-medium); }\n.gl :focus-visible { outline: 2px solid var(--color-fg-muted); outline-offset: 2px; }\n.gl-card { display: grid; gap: var(--cds-gap-md); min-width: 0; background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-lg); }\n.gl-cardtop { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-start; gap: var(--cds-gap-sm); }\n.gl-ttl { display: grid; gap: 2px; min-width: 0; }\n.gl-h2 { margin: 0; font-size: var(--cds-font-size-heading); font-weight: var(--cds-font-weight-medium); text-wrap: balance; }\n.gl-h2 .gl-co { color: var(--color-fg-muted); font-weight: 400; }\n.gl-sub { margin: 0; font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); max-width: 80ch; }\n.gl-nav { display: flex; gap: var(--cds-gap-xs); }\n.gl-nav .gl-btn { border: 1px solid var(--color-border-line); }\n.gl-stats { margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 9.5rem), 1fr)); gap: var(--cds-gap-md) var(--cds-gap-lg); }\n.gl-stats > div { display: grid; gap: 2px; align-content: start; min-width: 0; }\n.gl-stats dt { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n.gl-stats dd { margin: 0; display: grid; gap: 1px; }\n.gl-v { font-size: var(--cds-font-size-heading); font-weight: var(--cds-font-weight-medium); }\n.gl-s { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n.gl-legend { display: flex; flex-wrap: wrap; gap: var(--cds-gap-xs) var(--cds-gap-md); font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n.gl-k { display: inline-flex; align-items: center; gap: 6px; }\n.gl-key-line { display: inline-block; flex: none; width: 14px; height: 2px; border-radius: 1px; }\n.gl-key-dot { display: inline-block; flex: none; width: 9px; height: 9px; border-radius: 50%; box-sizing: border-box; border: 2px solid; }\n.gl-key-band { display: inline-block; flex: none; width: 12px; height: 10px; border-radius: 2px; background: var(--cds-chart-grid); }\n.gl-key-bar { display: inline-block; flex: none; width: 4px; height: 12px; border-radius: 1px; }\n.gl-key-ref { display: inline-block; flex: none; width: 0; height: 12px; border-left: 1px dashed var(--cds-chart-reference); }\n.gl-chart { position: relative; min-height: 484px; outline-offset: 4px; }\n.gl-chart svg { display: block; overflow: visible; }\n.gl-chart text { font-family: var(--font-anthropic-sans); font-size: var(--cds-font-size-caption); fill: var(--color-fg-muted); }\n.gl-chart .gl-tick { font-variant-numeric: tabular-nums; }\n.gl-chart .gl-lbl { fill: var(--color-fg); font-weight: var(--cds-font-weight-medium); paint-order: stroke; stroke: var(--color-panel); stroke-width: 3px; stroke-linejoin: round; }\n.gl-chart .gl-end-main { fill: var(--color-fg); font-weight: var(--cds-font-weight-medium); }\n.gl-tip { position: absolute; z-index: 2; display: grid; gap: 3px; pointer-events: none; background: var(--cds-surface-popover); border: 1px solid var(--cds-border); border-radius: var(--cds-radius); box-shadow: var(--cds-shadow-popover); padding: var(--cds-pad-xs) var(--cds-pad-sm); font-size: var(--cds-font-size-caption); }\n.gl-tip-d { color: var(--cds-text-secondary); }\n.gl-tip-r { display: flex; align-items: center; gap: 6px; white-space: nowrap; font-variant-numeric: tabular-nums; }\n.gl-tip-v { color: var(--color-fg); font-weight: var(--cds-font-weight-medium); }\n.gl-tip-n { color: var(--cds-text-secondary); }\n.gl-note { margin: 0; font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); max-width: 80ch; }\n.gl-fail { display: flex; align-items: center; justify-content: center; gap: 8px; min-height: inherit; color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); }\n.gl-fail::before { content: \"\"; width: .375rem; height: .375rem; border-radius: 50%; background: var(--color-bad); }\n.gl-tablewrap { overflow-x: auto; container-type: inline-size; }\n.gl-table { width: 100%; border-collapse: collapse; font-size: var(--cds-font-size-caption); font-variant-numeric: tabular-nums; }\n.gl-table th { padding: 0; text-align: left; white-space: nowrap; font-weight: var(--cds-font-weight-medium); color: var(--color-fg-muted); border-bottom: 1px solid var(--color-border-line); }\n.gl-table th button { font: inherit; color: inherit; background: none; border: 0; width: 100%; text-align: inherit; padding: var(--cds-pad-xs) var(--cds-pad-sm); cursor: pointer; }\n.gl-table th[aria-sort=\"ascending\"] button::after { content: \" ↑\"; }\n.gl-table th[aria-sort=\"descending\"] button::after { content: \" ↓\"; }\n.gl-table td { padding: var(--cds-pad-xs) var(--cds-pad-sm); white-space: nowrap; border-bottom: 1px solid var(--cds-chart-grid); }\n.gl-table .num { text-align: right; }\n.gl-table tbody tr { cursor: pointer; }\n.gl-table tbody tr:hover { background: color-mix(in srgb, var(--color-fg) 4%, transparent); }\n.gl-table tbody tr.is-sel { background: color-mix(in srgb, var(--color-fg) 9%, transparent); }\n.gl-table td.gl-c-theme { white-space: normal; min-width: 10rem; color: var(--color-fg-muted); }\n.gl-tkbtn { font: inherit; font-weight: var(--cds-font-weight-medium); color: var(--color-fg); background: none; border: 0; padding: 0; cursor: pointer; }\n@container (max-width: 760px) { .gl-table .gl-c-opt { display: none; } }\n@container (max-width: 520px) { .gl-table .gl-c-theme, .gl-table .gl-c-rs { display: none; } }\n.gl [hidden] { display: none !important; }\n.gl [data-dash-source-state=empty] { color: transparent; }\n.gl [data-dash-source-state=refreshing] { opacity: .5; transition: opacity var(--cds-dur-slow); }\n</style>\n\n<div class=\"gl\">\n  <header class=\"gl-head\" id=\"overview\">\n    <h1 class=\"gl-h1\">Growth leaders 2023–24</h1>\n    <p class=\"gl-takeaway dash-skeleton\" id=\"takeaway\">—</p>\n  </header>\n\n  <div class=\"gl-controls\" id=\"controls\">\n    <div class=\"gl-seg\" role=\"group\" aria-label=\"Leader list\">\n      <button type=\"button\" class=\"gl-btn\" id=\"list-2023\" data-list=\"2023\">2023 leaders</button>\n      <button type=\"button\" class=\"gl-btn\" id=\"list-2024\" data-list=\"2024\">2024 leaders</button>\n    </div>\n    <div class=\"gl-seg\" role=\"group\" aria-label=\"Chart range\">\n      <button type=\"button\" class=\"gl-btn\" id=\"range-2021\" data-range=\"2021\">From 2021</button>\n      <button type=\"button\" class=\"gl-btn\" id=\"range-2022\" data-range=\"2022\">From 2022</button>\n      <button type=\"button\" class=\"gl-btn\" id=\"range-2023\" data-range=\"2023\">From 2023</button>\n    </div>\n  </div>\n\n  <section class=\"gl-card\" id=\"chart-card\" aria-labelledby=\"chart-title\">\n    <div class=\"gl-cardtop\">\n      <div class=\"gl-ttl\">\n        <h2 class=\"gl-h2\" id=\"chart-title\"><span class=\"dash-skeleton\" data-source=\"leaders\" data-field=\"ticker\">—</span> <span class=\"gl-co\" data-source=\"leaders\" data-field=\"company\"></span></h2>\n        <p class=\"gl-sub\"><span data-source=\"leaders\" data-field=\"theme\"></span> · <span data-source=\"leaders\" data-field=\"category\"></span></p>\n      </div>\n      <div class=\"gl-nav\">\n        <button type=\"button\" class=\"gl-btn\" id=\"prev\">‹ Previous</button>\n        <button type=\"button\" class=\"gl-btn\" id=\"next\">Next ›</button>\n      </div>\n    </div>\n\n    <dl class=\"gl-stats\" id=\"stats\">\n      <div><dt>2023 return</dt><dd><span class=\"gl-v\" data-source=\"leaders\" data-field=\"ret_2023_pct\">—</span><span class=\"gl-s\">vs SPY <span data-source=\"leaders\" data-field=\"vs_spy_2023_pts\" data-opt=\"1\"></span> pts</span></dd></div>\n      <div><dt>2024 return</dt><dd><span class=\"gl-v\" data-source=\"leaders\" data-field=\"ret_2024_pct\">—</span><span class=\"gl-s\">vs SPY <span data-source=\"leaders\" data-field=\"vs_spy_2024_pts\" data-opt=\"1\"></span> pts</span></dd></div>\n      <div><dt>Bear-market drop</dt><dd><span class=\"gl-v\" data-source=\"leaders\" data-field=\"bear_drawdown_pct\">—</span><span class=\"gl-s\">from the <span data-source=\"leaders\" data-field=\"prior_high_date\"></span> high</span></dd></div>\n      <div><dt>Low</dt><dd><span class=\"gl-v\" data-source=\"leaders\" data-field=\"low_date\">—</span><span class=\"gl-s\">SPY's low: <span data-source=\"events\" data-field=\"start\" data-where=\"id=spy_low\"></span></span><span class=\"gl-s\">Volume <span data-source=\"leaders\" data-field=\"low_vol_vs_50d\" data-opt=\"1\"></span> its 50-day average</span></dd></div>\n      <div><dt>First new 52-week high</dt><dd><span class=\"gl-v\" data-source=\"leaders\" data-field=\"first_52w_high_date\">—</span><span class=\"gl-s\"><span data-source=\"leaders\" data-field=\"pct_off_low_at_52w_high\" data-opt=\"1\"></span> off the low</span><span class=\"gl-s\">Volume <span data-source=\"leaders\" data-field=\"high_vol_vs_50d\" data-opt=\"1\"></span> its 50-day average</span></dd></div>\n      <div><dt>RS line new high</dt><dd><span class=\"gl-v\" data-source=\"leaders\" data-field=\"rs_new_high_date\">—</span><span class=\"gl-s\">Ahead of price: <span data-source=\"leaders\" data-field=\"rs_led_price\"></span></span></dd></div>\n      <div><dt>In the 2023 correction</dt><dd><span class=\"gl-v\" data-source=\"leaders\" data-field=\"corr_2023_pct\">—</span><span class=\"gl-s\">SPY <span data-source=\"events\" data-field=\"spy_pct\" data-where=\"id=corr_2023\"></span>, <span data-source=\"events\" data-field=\"start\" data-where=\"id=corr_2023\" data-fmt=\"mon\"></span>–<span data-source=\"events\" data-field=\"end\" data-where=\"id=corr_2023\"></span></span></dd></div>\n      <div><dt>In the 2024 pullback</dt><dd><span class=\"gl-v\" data-source=\"leaders\" data-field=\"corr_2024_pct\">—</span><span class=\"gl-s\">SPY <span data-source=\"events\" data-field=\"spy_pct\" data-where=\"id=corr_2024\"></span>, <span data-source=\"events\" data-field=\"start\" data-where=\"id=corr_2024\" data-fmt=\"mon\"></span>–<span data-source=\"events\" data-field=\"end\" data-where=\"id=corr_2024\"></span></span></dd></div>\n    </dl>\n\n    <div class=\"gl-legend\" id=\"legend\" data-source=\"leaders\"></div>\n    <div class=\"gl-chart dash-skeleton\" id=\"price-chart\" data-source=\"prices volumes leaders events\" tabindex=\"0\" role=\"group\" aria-label=\"Price chart with SPY, QQQ, daily volume and the RS line. Use the left and right arrow keys to read values.\"></div>\n    <p class=\"gl-note\">Daily closes and volume, split-adjusted, from Massive. SPY and QQQ are rebased to the stock's close on its low, so the gap between the lines is performance since that day. Volume bars are shares traded each day, the line through them is the average of the prior 50 sessions, and the callouts give volume on the low and first-new-high days as a multiple of that average. The RS line is the stock divided by SPY, set to 100 on the low. A new 52-week high is a close above every close of the prior 251 trading days; the RS line's new high uses the same rule. Shaded bands are SPY's two pullbacks inside the uptrend.</p>\n  </section>\n\n  <section class=\"gl-card\" id=\"table-card\" aria-labelledby=\"table-title\">\n    <div class=\"gl-ttl\">\n      <h2 class=\"gl-h2\" id=\"table-title\">Leaders, ranked by return</h2>\n      <p class=\"gl-sub\">Select a row to chart it. SPY's first new 52-week high came on <span data-source=\"events\" data-field=\"start\" data-where=\"id=spy_52w\"></span>, and QQQ's on <span data-source=\"events\" data-field=\"start\" data-where=\"id=qqq_52w\"></span>.</p>\n    </div>\n    <div class=\"gl-tablewrap\">\n      <table class=\"gl-table\" id=\"leaders-table\" data-source=\"leaders\" data-row-key=\"ticker\">\n        <thead><tr></tr></thead>\n        <tbody></tbody>\n      </table>\n    </div>\n  </section>\n</div>\n\n<script>\ndash.calc('takeaway', {\n  inputs: ['leaders', 'events'],\n  title: 'Leaders ahead of the index',\n  description: '2023 list: leaders whose first new 52-week high came before SPY’s. 2024 list: leaders whose low came in 2023 or later.',\n  fn: (leaders, events) => {\n    const spyHigh = events.find((e) => e.id === 'spy_52w').start;\n    const has = (v) => v !== null && v !== undefined && v !== '';\n    const l23 = leaders.filter((r) => has(r.rank_2023));\n    const l24 = leaders.filter((r) => has(r.rank_2024));\n    return [\n      { list: '2023', count: l23.filter((r) => has(r.first_52w_high_date) && r.first_52w_high_date < spyHigh).length, total: l23.length },\n      { list: '2024', count: l24.filter((r) => has(r.low_date) && r.low_date >= '2023-01-01').length, total: l24.length },\n    ];\n  },\n});\n\n(() => {\n  const root = document.querySelector('.gl');\n  const q = (s) => root.querySelector(s);\n  const parseDay = d3.utcParse('%Y-%m-%d');\n  const dLong = d3.utcFormat('%b %-d, %Y');\n  const dMon = d3.utcFormat('%b %-d');\n  const dShort = d3.utcFormat('%-m/%-d/%y');\n  const has = (v) => v !== null && v !== undefined && v !== '';\n  const n = (v) => (has(v) ? +v : null);\n  const ok = (v) => v !== null && v !== undefined && Number.isFinite(v) && v > 0;\n  const day = (s, f) => (has(s) ? (f || dLong)(parseDay(String(s).slice(0, 10))) : '—');\n  const fSigned = d3.format('+,.0f');\n  const fSigned1 = d3.format('+,.1f');\n  const pct = (v) => (has(v) ? fSigned(+v) + '%' : '—');\n  const pct1 = (v) => (has(v) ? fSigned1(+v) + '%' : '—');\n  const pts = (v) => (has(v) ? fSigned(+v) : '—');\n  const money = (v) => (v >= 10 ? d3.format('$,.2f')(v) : d3.format('$,.3~f')(v));\n  const tickMoney = (v) => (v >= 10 ? d3.format('$,.0f')(v) : d3.format('$,.2~f')(v));\n  const tickRs = d3.format(',.3~r');\n  const tickVol = d3.format('.3~s');\n  const fX = (v) => (has(v) ? d3.format('.1f')(+v) + '×' : '—');\n\n  const FMT = {\n    low_vol_vs_50d: fX, high_vol_vs_50d: fX,\n    ret_2023_pct: pct, ret_2024_pct: pct, bear_drawdown_pct: pct, pct_off_low_at_52w_high: pct,\n    vs_spy_2023_pts: pts, vs_spy_2024_pts: pts, corr_2023_pct: pct1, corr_2024_pct: pct1,\n    prior_high_date: day, low_date: day, first_52w_high_date: day, rs_new_high_date: day,\n  };\n  const COLS = [\n    { id: 'rank', label: () => '#', field: (l) => `rank_${l}`, num: true, first: 1 },\n    { id: 'ticker', label: () => 'Ticker', field: () => 'ticker', key: true, first: 1 },\n    { id: 'theme', label: () => 'What it is', field: () => 'theme', cls: 'gl-c-theme', first: 1 },\n    { id: 'ret', label: (l) => `${l} return`, field: (l) => `ret_${l}_pct`, num: true, fmt: pct, first: -1 },\n    { id: 'vs', label: () => 'vs SPY, pts', field: (l) => `vs_spy_${l}_pts`, num: true, fmt: pts, cls: 'gl-c-opt', first: -1 },\n    { id: 'drop', label: () => 'Bear drop', field: () => 'bear_drawdown_pct', num: true, fmt: pct, cls: 'gl-c-opt', first: 1 },\n    { id: 'low', label: () => 'Low', field: () => 'low_date', fmt: (v) => day(v, dShort), first: 1 },\n    { id: 'hi', label: () => 'First 52-wk high', field: () => 'first_52w_high_date', fmt: (v) => day(v, dShort), first: 1 },\n    { id: 'bvol', label: () => 'Vol at 1st high', field: () => 'high_vol_vs_50d', num: true, fmt: fX, cls: 'gl-c-opt', first: -1 },\n    { id: 'rs', label: () => 'RS new high', field: () => 'rs_new_high_date', fmt: (v) => day(v, dShort), cls: 'gl-c-rs', first: 1 },\n    { id: 'led', label: () => 'RS ahead', field: () => 'rs_led_price', cls: 'gl-c-opt', first: -1 },\n  ];\n\n  const state = { sort: { id: 'rank', dir: 1 }, order: [], sel: null, kIdx: null };\n\n  const params = () => {\n    const p = dash.params() || {};\n    return {\n      list: String(p.list) === '2024' ? '2024' : '2023',\n      range: ['2021', '2022', '2023'].includes(String(p.range)) ? String(p.range) : '2022',\n      ticker: has(p.ticker) ? String(p.ticker) : '',\n    };\n  };\n\n  const failLine = () => {\n    const d = document.createElement('div');\n    d.className = 'gl-fail';\n    d.textContent = 'Failed to load';\n    return d;\n  };\n  const settle = (el, status) => {\n    if (status === 'ok' || status === 'error') el.classList.remove('dash-skeleton');\n  };\n  const step = (d) => {\n    const o = state.order;\n    if (!o.length) return;\n    const i = Math.max(0, o.indexOf(state.sel));\n    dash.setParams({ ticker: o[(i + d + o.length) % o.length] });\n  };\n\n  root.querySelectorAll('[data-list]').forEach((b) => b.addEventListener('click', () => dash.setParams({ list: b.dataset.list })));\n  root.querySelectorAll('[data-range]').forEach((b) => b.addEventListener('click', () => dash.setParams({ range: b.dataset.range })));\n  q('#prev').addEventListener('click', () => step(-1));\n  q('#next').addEventListener('click', () => step(1));\n  q('#leaders-table tbody').addEventListener('click', (e) => {\n    const tr = e.target.closest('tr[data-key]');\n    if (tr) dash.setParams({ ticker: tr.dataset.key });\n  });\n  q('#leaders-table thead').addEventListener('click', (e) => {\n    const b = e.target.closest('button[data-col]');\n    if (!b) return;\n    const c = COLS.find((x) => x.id === b.dataset.col);\n    state.sort = state.sort.id === c.id ? { id: c.id, dir: -state.sort.dir } : { id: c.id, dir: c.first };\n    render();\n  });\n\n  const caches = new Map();\n  function prep(name, rows) {\n    const prev = caches.get(name);\n    if (prev && prev.src === rows) return prev;\n    const keys = rows.map((r) => String(r.date).slice(0, 10));\n    const pos = new Map(keys.map((k, i) => [k, i]));\n    const cols = new Map();\n    const cache = {\n      src: rows,\n      keys,\n      dates: keys.map(parseDay),\n      index: (k) => (has(k) && pos.has(String(k).slice(0, 10)) ? pos.get(String(k).slice(0, 10)) : null),\n      get: (t) => {\n        if (!cols.has(t)) cols.set(t, rows.map((r) => (has(r[t]) ? +r[t] : null)));\n        return cols.get(t);\n      },\n    };\n    caches.set(name, cache);\n    return cache;\n  }\n\n  function logTicks(scale, count) {\n    const lead = (v) => Math.round(v / Math.pow(10, Math.floor(Math.log10(v))));\n    let t = scale.ticks(count);\n    if (t.length > count + 2) t = t.filter((v) => [1, 2, 5].includes(lead(v)));\n    if (t.length > count + 2) t = t.filter((v) => lead(v) === 1);\n    return t;\n  }\n\n  function padLog(vals, h, padBot, padTop) {\n    let a = Math.log(d3.min(vals));\n    let b = Math.log(d3.max(vals));\n    if (!(b > a)) { a -= 0.05; b += 0.05; }\n    const span = (b - a) / (1 - (padBot + padTop) / h);\n    return [Math.exp(a - (span * padBot) / h), Math.exp(b + (span * padTop) / h)];\n  }\n\n  function renderEvents(E) {\n    const evs = E.status === 'ok' ? E.data : [];\n    root.querySelectorAll('[data-source=\"events\"][data-field]').forEach((el) => {\n      settle(el, E.status);\n      const id = new URLSearchParams(el.dataset.where || '').get('id');\n      const row = evs.find((e) => e.id === id);\n      if (!row) { el.textContent = '—'; return; }\n      const f = el.dataset.field;\n      el.textContent = f === 'spy_pct' ? pct1(row[f]) : day(row[f], el.dataset.fmt === 'mon' ? dMon : dLong);\n    });\n  }\n\n  function renderTakeaway(p, T, E) {\n    const el = q('#takeaway');\n    if (T.status !== 'ok' || E.status !== 'ok') {\n      if (T.status === 'error' || E.status === 'error') { el.classList.remove('dash-skeleton'); el.textContent = ''; }\n      return;\n    }\n    const row = (T.data || []).find((r) => String(r.list) === p.list);\n    const ev = E.data.find((e) => e.id === (p.list === '2023' ? 'spy_52w' : 'spy_low'));\n    if (!row || !ev) return;\n    el.classList.remove('dash-skeleton');\n    const mk = (src, field, where, text) => {\n      const s = document.createElement('span');\n      s.dataset.source = src;\n      s.dataset.field = field;\n      s.dataset.where = where;\n      s.textContent = text;\n      return s;\n    };\n    const w = `list=${p.list}`;\n    el.replaceChildren();\n    if (p.list === '2023') {\n      el.append(mk('takeaway', 'count', w, String(row.count)), ' of these ', mk('takeaway', 'total', w, String(row.total)),\n        ' made a new 52-week high before SPY did on ', mk('events', 'start', 'id=spy_52w', day(ev.start)), '.');\n    } else {\n      el.append(mk('takeaway', 'count', w, String(row.count)), ' of these ', mk('takeaway', 'total', w, String(row.total)),\n        ' bottomed in 2023 or later, well after SPY’s ', mk('events', 'start', 'id=spy_low', day(ev.start)), ' low.');\n    }\n  }\n\n  function renderStats(sel, L) {\n    q('#chart-card').querySelectorAll('[data-source=\"leaders\"][data-field]').forEach((el) => {\n      settle(el, L.status);\n      if (!sel) { el.removeAttribute('data-where'); el.textContent = '—'; return; }\n      el.dataset.where = 'ticker=' + encodeURIComponent(String(sel.ticker));\n      const f = el.dataset.field;\n      const v = sel[f];\n      el.textContent = FMT[f] ? FMT[f](v) : has(v) ? String(v) : '—';\n      if (el.dataset.opt) el.closest('.gl-s').hidden = !has(v);\n    });\n  }\n\n  function renderLegend(sel) {\n    const box = q('#legend');\n    box.replaceChildren();\n    if (!sel) return;\n    const c = dash.colors;\n    const item = (keyEl, text) => {\n      const s = document.createElement('span');\n      s.className = 'gl-k';\n      s.append(keyEl, document.createTextNode(text));\n      box.append(s);\n    };\n    const key = (cls, style) => {\n      const k = document.createElement('span');\n      k.className = cls;\n      Object.assign(k.style, style || {});\n      return k;\n    };\n    item(key('gl-key-line', { background: c[0] }), String(sel.ticker));\n    item(key('gl-key-line', { background: c[1] }), 'SPY, rebased to the low');\n    item(key('gl-key-line', { background: c[2] }), 'QQQ, rebased to the low');\n    item(key('gl-key-dot', { borderColor: c[0], background: 'var(--color-panel)' }), 'Low');\n    item(key('gl-key-dot', { borderColor: c[0], background: c[0] }), 'First new 52-week high');\n    item(key('gl-key-bar', { background: 'var(--cds-chart-muted)' }), 'Volume');\n    item(key('gl-key-line', { background: 'var(--cds-chart-reference)' }), '50-day average volume');\n    item(key('gl-key-bar', { background: c[0] }), 'Volume on the low and first new high');\n    item(key('gl-key-ref'), 'SPY low and first new high');\n    item(key('gl-key-band'), 'SPY pullbacks');\n  }\n\n  function renderTable(p, list, L) {\n    const table = q('#leaders-table');\n    q('#table-title').textContent = `${p.list} leaders, ranked by return`;\n    table.tHead.rows[0].replaceChildren(...COLS.map((c) => {\n      const th = document.createElement('th');\n      th.dataset.field = c.field(p.list);\n      if (c.num) th.classList.add('num');\n      if (c.cls) th.classList.add(c.cls);\n      th.setAttribute('aria-sort', state.sort.id === c.id ? (state.sort.dir > 0 ? 'ascending' : 'descending') : 'none');\n      const b = document.createElement('button');\n      b.type = 'button';\n      b.dataset.col = c.id;\n      b.textContent = c.label(p.list);\n      th.append(b);\n      return th;\n    }));\n    const tb = table.tBodies[0];\n    if (L.status === 'error') {\n      const tr = document.createElement('tr');\n      const td = document.createElement('td');\n      td.colSpan = COLS.length;\n      td.append(failLine());\n      tr.append(td);\n      tb.replaceChildren(tr);\n      return;\n    }\n    const sc = COLS.find((c) => c.id === state.sort.id) || COLS[0];\n    const sf = sc.field(p.list);\n    const sorted = list.slice().sort((a, b) => {\n      const va = a[sf];\n      const vb = b[sf];\n      if (!has(va) && !has(vb)) return 0;\n      if (!has(va)) return 1;\n      if (!has(vb)) return -1;\n      return (sc.num ? n(va) - n(vb) : String(va).localeCompare(String(vb))) * state.sort.dir;\n    });\n    tb.replaceChildren(...sorted.map((r) => {\n      const tr = document.createElement('tr');\n      tr.dataset.key = String(r.ticker);\n      if (String(r.ticker) === state.sel) { tr.classList.add('is-sel'); tr.setAttribute('aria-current', 'true'); }\n      COLS.forEach((c) => {\n        const td = document.createElement('td');\n        if (c.num) td.classList.add('num');\n        if (c.cls) td.classList.add(c.cls);\n        const v = r[c.field(p.list)];\n        if (c.key) {\n          const b = document.createElement('button');\n          b.type = 'button';\n          b.className = 'gl-tkbtn';\n          b.textContent = String(v);\n          td.append(b);\n        } else {\n          td.textContent = c.fmt ? c.fmt(v) : has(v) ? String(v) : '—';\n        }\n        tr.append(td);\n      });\n      return tr;\n    }));\n  }\n\n  function renderChart(p, sel, L, Pr, Vo, E) {\n    const box = q('#price-chart');\n    const st = [L.status, Pr.status, Vo.status, E.status];\n    if (st.includes('error')) { box.classList.remove('dash-skeleton'); box.replaceChildren(failLine()); return; }\n    if (st.some((s) => s !== 'ok') || !sel) { box.replaceChildren(); box.classList.add('dash-skeleton'); return; }\n    box.classList.remove('dash-skeleton');\n    drawChart(box, prep('prices', Pr.data), prep('volumes', Vo.data), sel, E.data, p.range);\n  }\n\n  function drawChart(box, P, V, sel, events, range) {\n    box.replaceChildren();\n    const W = Math.floor(box.clientWidth);\n    if (!W) return;\n    const colors = dash.colors;\n    const t = String(sel.ticker);\n    const S = P.get(t);\n    const SPY = P.get('SPY');\n    const QQQ = P.get('QQQ');\n    const iEnd = P.keys.length - 1;\n    const i0 = Math.min(d3.bisectLeft(P.keys, `${range}-01-01`), iEnd);\n    const iLow = P.index(sel.low_date);\n    if (iLow === null || !ok(S[iLow])) return;\n    const sL = S[iLow];\n    const spyL = SPY[iLow];\n    const qqqL = QQQ[iLow];\n    const rsL = sL / spyL;\n\n    // daily volume on the price dates, and the average of the 50 sessions before each day\n    const vCol = V.get(t);\n    const vol = P.keys.map((k) => {\n      const j = V.index(k);\n      return j === null ? null : vCol[j];\n    });\n    const avg50 = vol.map((_, i) => {\n      const prior = vol.slice(Math.max(0, i - 50), i).filter(ok);\n      return prior.length >= 20 ? d3.mean(prior) : null;\n    });\n\n    const data = [];\n    for (let i = i0; i <= iEnd; i++) {\n      const s = ok(S[i]) ? S[i] : null;\n      data.push({ i, d: P.dates[i], s, spy: (SPY[i] * sL) / spyL, qqq: (QQQ[i] * sL) / qqqL, rs: s !== null ? (100 * (s / SPY[i])) / rsL : null });\n    }\n    const first = data[0];\n    const last = data[data.length - 1];\n\n    const priceH = Math.round(Math.max(220, Math.min(400, W * 0.42)));\n    const rsH = Math.round(Math.max(100, Math.min(150, priceH * 0.38)));\n    const volH = Math.round(Math.max(64, Math.min(100, priceH * 0.26)));\n    const mt = 34;\n    const gapH = 30;\n    const axH = 24;\n    const pTop = mt;\n    const pBot = mt + priceH;\n    const vTop = pBot + 12;\n    const vBot = vTop + volH;\n    const rTop = vBot + gapH;\n    const rBot = rTop + rsH;\n    const H = rBot + axH;\n\n    const yP = d3.scaleLog(padLog(data.flatMap((d) => [d.s, d.spy, d.qqq]).filter(ok), priceH, 26, 20), [pBot, pTop]);\n    const yR = d3.scaleLog(padLog(data.map((d) => d.rs).filter(ok).concat([100]), rsH, 8, 18), [rBot, rTop]);\n    const vMax = d3.max(data, (d) => (ok(vol[d.i]) ? vol[d.i] : 0)) || 1;\n    const yV = d3.scaleLinear([0, vMax], [vBot, vTop + 26]);\n\n    const svg = d3.select(box).append('svg')\n      .attr('width', '100%').attr('height', H).attr('viewBox', `0 0 ${W} ${H}`)\n      .attr('role', 'img').attr('aria-label', `${t} price with SPY and QQQ rebased to its low, and its RS line`);\n    const measure = (texts, cls) => {\n      const g = svg.append('g');\n      const w = d3.max(texts, (s) => g.append('text').attr('class', cls || null).text(s).node().getComputedTextLength()) || 0;\n      g.remove();\n      return w;\n    };\n    const pT = logTicks(yP, priceH > 300 ? 6 : 4);\n    const rT = logTicks(yR, 3);\n    const vT = yV.ticks(2).filter((v) => v > 0 && yV(v) >= vTop + 26);\n    const ml = Math.ceil(Math.max(measure(pT.map(tickMoney), 'gl-tick'), measure(rT.map(tickRs), 'gl-tick'), measure(vT.map(tickVol), 'gl-tick'))) + 10;\n    const ends = [{ k: t, v: last.s, c: 0 }, { k: 'SPY', v: last.spy, c: 1 }, { k: 'QQQ', v: last.qqq, c: 2 }].filter((e) => ok(e.v));\n    const mr = Math.ceil(measure(ends.map((e) => e.k), 'gl-end-main')) + 14;\n    const x = d3.scaleUtc([first.d, last.d], [ml, W - mr]);\n    const inX = (d) => d >= first.d && d <= last.d;\n    const panes = [[pTop, pBot], [vTop, vBot], [rTop, rBot]];\n\n    // pullback bands, drawn under everything\n    const bands = events.filter((e) => has(e.end))\n      .map((e) => ({ e, a: parseDay(e.start), b: parseDay(e.end) }))\n      .filter((o) => o.b >= first.d && o.a <= last.d);\n    const gB = svg.append('g');\n    bands.forEach((o) => {\n      const xa = x(o.a < first.d ? first.d : o.a);\n      const xb = x(o.b > last.d ? last.d : o.b);\n      panes.forEach(([a, b]) => gB.append('rect').attr('x', xa).attr('y', a).attr('width', Math.max(1, xb - xa)).attr('height', b - a)\n        .style('fill', 'var(--cds-chart-grid)').style('fill-opacity', 0.7));\n    });\n\n    // grid and y ticks\n    const gG = svg.append('g');\n    const yGrid = (ticks, ys, fmt) => ticks.forEach((v) => {\n      gG.append('line').attr('x1', ml).attr('x2', W - mr).attr('y1', ys(v)).attr('y2', ys(v)).style('stroke', 'var(--cds-chart-grid)');\n      gG.append('text').attr('class', 'gl-tick').attr('x', ml - 8).attr('y', ys(v)).attr('dy', '0.32em').attr('text-anchor', 'end').text(fmt(v));\n    });\n    yGrid(pT, yP, tickMoney);\n    yGrid(rT, yR, tickRs);\n    yGrid(vT, yV, tickVol);\n    [pBot, vBot, rBot].forEach((y) => gG.append('line').attr('x1', ml).attr('x2', W - mr).attr('y1', y).attr('y2', y).style('stroke', 'var(--cds-chart-axis)'));\n\n    // index reference dates and the RS = 100 line\n    const refs = ['spy_low', 'spy_52w'].map((id) => events.find((e) => e.id === id)).filter(Boolean)\n      .map((e) => ({ e, d: parseDay(e.start) })).filter((o) => inX(o.d));\n    const gR = svg.append('g');\n    refs.forEach((o) => panes.forEach(([a, b]) => gR.append('line').attr('x1', x(o.d)).attr('x2', x(o.d)).attr('y1', a).attr('y2', b)\n      .style('stroke', 'var(--cds-chart-reference)').attr('stroke-dasharray', '3 3')));\n    gR.append('line').attr('x1', ml).attr('x2', W - mr).attr('y1', yR(100)).attr('y2', yR(100))\n      .style('stroke', 'var(--cds-chart-reference)').attr('stroke-dasharray', '3 3');\n\n    // series\n    const path = (acc, ys, c, w) => svg.append('path').datum(data)\n      .attr('d', d3.line().defined((d) => ok(acc(d))).x((d) => x(d.d)).y((d) => ys(acc(d))))\n      .style('fill', 'none').style('stroke', colors[c]).style('stroke-width', w)\n      .style('stroke-linejoin', 'round').style('stroke-linecap', 'round');\n    path((d) => d.qqq, yP, 2, 1.5);\n    path((d) => d.spy, yP, 1, 1.5);\n    path((d) => d.s, yP, 0, 2);\n    path((d) => d.rs, yR, 0, 2);\n\n    // volume bars, the 50-session average, and the two run-start days called out\n    const slot = (W - mr - ml) / Math.max(1, data.length);\n    const bw = Math.max(1, slot * 0.7);\n    let bars = '';\n    data.forEach((d) => {\n      const v = vol[d.i];\n      if (!ok(v)) return;\n      bars += `M${(x(d.d) - bw / 2).toFixed(1)},${vBot}V${yV(v).toFixed(1)}h${bw.toFixed(2)}V${vBot}Z`;\n    });\n    svg.append('path').attr('d', bars).style('fill', 'var(--cds-chart-muted)');\n    svg.append('path').datum(data)\n      .attr('d', d3.line().defined((d) => ok(avg50[d.i])).x((d) => x(d.d)).y((d) => yV(avg50[d.i])))\n      .style('fill', 'none').style('stroke', 'var(--cds-chart-reference)').style('stroke-width', 1.25)\n      .style('stroke-linejoin', 'round');\n    const gV = svg.append('g');\n    const rowEndV = [-Infinity, -Infinity];\n    [[sel.low_date, sel.low_vol_vs_50d], [sel.first_52w_high_date, sel.high_vol_vs_50d]]\n      .map(([date, ratio]) => ({ j: P.index(date), ratio: n(ratio) }))\n      .filter((o) => o.j !== null && o.j >= i0 && ok(vol[o.j]))\n      .sort((a, b) => a.j - b.j)\n      .forEach((o) => {\n        const cx = x(P.dates[o.j]);\n        const hw = Math.max(3, bw + 1);\n        gV.append('rect').attr('x', cx - hw / 2).attr('width', hw).attr('y', yV(vol[o.j])).attr('height', vBot - yV(vol[o.j]))\n          .style('fill', colors[0]);\n        if (o.ratio === null) return;\n        const tx = gV.append('text').attr('class', 'gl-lbl').attr('text-anchor', 'middle').text(`${fX(o.ratio)} avg`);\n        const w = tx.node().getComputedTextLength();\n        const lx = Math.max(ml + w / 2 + 2, Math.min(W - mr - w / 2 - 2, cx));\n        const r = rowEndV.findIndex((e) => lx - w / 2 > e + 6);\n        if (r < 0) { tx.remove(); return; }\n        rowEndV[r] = lx + w / 2;\n        tx.attr('x', lx).attr('y', vTop + 9 + r * 12);\n      });\n\n    // RS pane title\n    svg.append('text').attr('x', ml).attr('y', rTop - 10).text('RS line vs SPY (100 = the low)');\n\n    // run-start markers\n    const gM = svg.append('g');\n    const marker = (date, ys, acc, filled, text, above, pane) => {\n      const j = P.index(date);\n      if (j === null || j < i0) return;\n      const d = data[j - i0];\n      if (!d || !ok(acc(d))) return;\n      const v = acc(d);\n      const cx = x(d.d);\n      const cy = ys(v);\n      gM.append('circle').attr('cx', cx).attr('cy', cy).attr('r', 4.5)\n        .style('fill', filled ? colors[0] : 'var(--color-panel)')\n        .style('stroke', filled ? 'var(--color-panel)' : colors[0]).style('stroke-width', 2);\n      let ty = above ? cy - 10 : cy + 18;\n      if (above && ty - 12 < pane[0]) ty = cy + 18;\n      if (!above && ty > pane[1] - 2) ty = cy - 10;\n      const tx = gM.append('text').attr('class', 'gl-lbl').attr('text-anchor', 'middle').attr('y', ty).text(text);\n      const w = tx.node().getComputedTextLength();\n      tx.attr('x', Math.max(ml + w / 2 + 2, Math.min(W - mr - w / 2 - 2, cx)));\n    };\n    marker(sel.low_date, yP, (d) => d.s, false, `Low · ${day(sel.low_date)}`, false, panes[0]);\n    marker(sel.first_52w_high_date, yP, (d) => d.s, true, `First 52-wk high · ${day(sel.first_52w_high_date)}`, true, panes[0]);\n    marker(sel.rs_new_high_date, yR, (d) => d.rs, true, `RS new high · ${day(sel.rs_new_high_date)}`, true, panes[1]);\n\n    // labels for the reference lines and bands, stacked in two rows above the plot\n    const tops = refs.map((o) => ({ d: o.d, text: o.e.label }))\n      .concat(bands.filter((o) => inX(o.a)).map((o) => ({ d: o.a, text: `SPY ${pct1(o.e.spy_pct)}` })))\n      .sort((a, b) => a.d - b.d);\n    const rowEnd = [-Infinity, -Infinity];\n    tops.forEach((o) => {\n      const tx = svg.append('text').text(o.text);\n      const w = tx.node().getComputedTextLength();\n      let anchor = 'start';\n      let x0 = x(o.d) + 3;\n      if (x0 + w > W - mr) { anchor = 'end'; x0 = x(o.d) - 3; }\n      const left = anchor === 'start' ? x0 : x0 - w;\n      const right = anchor === 'start' ? x0 + w : x0;\n      const r = rowEnd.findIndex((e) => left > e + 6);\n      if (r < 0) { tx.remove(); return; }\n      rowEnd[r] = right;\n      tx.attr('x', x0).attr('y', 12 + r * 14).attr('text-anchor', anchor);\n    });\n\n    // line-end labels, pushed apart so they never touch\n    ends.forEach((e) => { e.y = yP(e.v); });\n    ends.sort((a, b) => a.y - b.y);\n    for (let i = 1; i < ends.length; i++) ends[i].y = Math.max(ends[i].y, ends[i - 1].y + 13);\n    const over = ends.length ? ends[ends.length - 1].y - (pBot - 4) : 0;\n    if (over > 0) ends.forEach((e) => { e.y -= over; });\n    ends.forEach((e) => svg.append('text').attr('class', e.c === 0 ? 'gl-end-main' : null)\n      .attr('x', W - mr + 6).attr('y', e.y).attr('dy', '0.32em').text(e.k));\n\n    // x axis\n    const months = (last.d - first.d) / (30.44 * 864e5);\n    const perMonth = (W - mr - ml) / Math.max(1, months);\n    const every = perMonth >= 26 ? 3 : perMonth >= 11 ? 6 : 12;\n    d3.utcMonth.every(every).range(d3.utcYear.floor(first.d), d3.utcDay.offset(last.d, 1))\n      .filter((d) => d >= d3.utcDay.offset(first.d, -7))\n      .forEach((d) => {\n        const xx = Math.max(ml, x(d));\n        gG.append('line').attr('x1', xx).attr('x2', xx).attr('y1', rBot).attr('y2', rBot + 4).style('stroke', 'var(--cds-chart-axis)');\n        gG.append('text').attr('class', 'gl-tick').attr('x', xx).attr('y', rBot + 17).attr('text-anchor', xx <= ml + 12 ? 'start' : 'middle')\n          .text(d.getUTCMonth() === 0 ? d3.utcFormat('%Y')(d) : d3.utcFormat('%b')(d));\n      });\n\n    // crosshair and tooltip\n    const tip = document.createElement('div');\n    tip.className = 'gl-tip';\n    tip.hidden = true;\n    box.append(tip);\n    const focus = svg.append('g').style('display', 'none').attr('pointer-events', 'none');\n    const vline = focus.append('line').attr('y1', pTop).attr('y2', rBot).style('stroke', 'var(--cds-chart-axis)');\n    const dots = [['s', yP, 0], ['spy', yP, 1], ['qqq', yP, 2], ['rs', yR, 0]].map(([k, ys, c]) => ({\n      k, ys, el: focus.append('circle').attr('r', 4).style('fill', colors[c]).style('stroke', 'var(--color-panel)').style('stroke-width', 2),\n    }));\n    const times = data.map((d) => +d.d);\n    const vsLow = (v, base) => `${fSigned((v / base - 1) * 100)}% vs low`;\n    const tipRow = (color, val, name) => {\n      const r = document.createElement('div');\n      r.className = 'gl-tip-r';\n      const k = document.createElement('span');\n      k.className = 'gl-key-line';\n      k.style.background = color;\n      const v = document.createElement('span');\n      v.className = 'gl-tip-v';\n      v.textContent = val;\n      const nm = document.createElement('span');\n      nm.className = 'gl-tip-n';\n      nm.textContent = name;\n      r.append(k, v, nm);\n      tip.append(r);\n    };\n    const show = (j) => {\n      const d = data[j];\n      if (!d) return;\n      state.kIdx = j;\n      const cx = x(d.d);\n      focus.style('display', null);\n      vline.attr('x1', cx).attr('x2', cx);\n      dots.forEach((o) => {\n        const v = d[o.k];\n        if (ok(v)) o.el.attr('cx', cx).attr('cy', o.ys(v)).style('display', null);\n        else o.el.style('display', 'none');\n      });\n      tip.replaceChildren();\n      const head = document.createElement('div');\n      head.className = 'gl-tip-d';\n      head.textContent = dLong(d.d);\n      tip.append(head);\n      if (ok(d.s)) tipRow(colors[0], money(d.s), `${t} · ${vsLow(d.s, sL)}`);\n      tipRow(colors[1], money(SPY[d.i]), `SPY · ${vsLow(SPY[d.i], spyL)}`);\n      tipRow(colors[2], money(QQQ[d.i]), `QQQ · ${vsLow(QQQ[d.i], qqqL)}`);\n      if (ok(vol[d.i])) {\n        tipRow('var(--cds-chart-muted)', tickVol(vol[d.i]),\n          ok(avg50[d.i]) ? `Volume · ${fX(vol[d.i] / avg50[d.i])} 50-day avg` : 'Volume');\n      }\n      if (ok(d.rs)) tipRow(colors[0], d3.format(',.0f')(d.rs), 'RS line');\n      tip.hidden = false;\n      const tw = tip.offsetWidth;\n      let left = cx + 14;\n      if (left + tw > W) left = cx - 14 - tw;\n      tip.style.left = `${Math.max(0, left)}px`;\n      tip.style.top = `${pTop}px`;\n    };\n    const hide = () => { focus.style('display', 'none'); tip.hidden = true; };\n    svg.append('rect').attr('x', ml).attr('y', pTop).attr('width', Math.max(0, W - mr - ml)).attr('height', rBot - pTop)\n      .style('fill', 'transparent').style('cursor', 'crosshair')\n      .on('pointermove', (ev) => {\n        const [mx] = d3.pointer(ev);\n        show(d3.bisector((v) => v).center(times, +x.invert(mx)));\n      })\n      .on('pointerleave', hide);\n    if (state.kIdx !== null && state.kIdx >= data.length) state.kIdx = null;\n    box.onkeydown = (e) => {\n      if (e.key === 'Escape') { hide(); return; }\n      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;\n      e.preventDefault();\n      const by = e.shiftKey ? 21 : 5;\n      const from = state.kIdx === null ? data.length - 1 : state.kIdx;\n      show(Math.max(0, Math.min(data.length - 1, from + (e.key === 'ArrowLeft' ? -by : by))));\n    };\n    box.onblur = hide;\n  }\n\n  function render() {\n    const p = params();\n    const L = dash.data('leaders');\n    const Pr = dash.data('prices');\n    const E = dash.data('events');\n    const Vo = dash.data('volumes');\n    const T = dash.data('takeaway');\n    root.querySelectorAll('[data-list]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.list === p.list)));\n    root.querySelectorAll('[data-range]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.range === p.range)));\n    const rows = L.status === 'ok' ? L.data : [];\n    const rankF = `rank_${p.list}`;\n    const list = rows.filter((r) => has(r[rankF])).sort((a, b) => n(a[rankF]) - n(b[rankF]));\n    state.order = list.map((r) => String(r.ticker));\n    const sel = list.find((r) => String(r.ticker) === p.ticker) || list[0] || null;\n    state.sel = sel ? String(sel.ticker) : null;\n    renderEvents(E);\n    renderTakeaway(p, T, E);\n    renderStats(sel, L);\n    renderLegend(sel);\n    renderTable(p, list, L);\n    renderChart(p, sel, L, Pr, Vo, E);\n  }\n\n  dash.onData(render);\n})();\n</script>\n"}